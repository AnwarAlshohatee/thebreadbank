<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>The Bread Bank | Share Food, Build Community</title>

  <!-- Bootstrap styling -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
</head>

<body class="bg-light">

  <!-- Navigation bar -->
  <nav class="navbar navbar-light bg-white border-bottom shadow-sm">
    <div class="container">

      <a href="/" class="navbar-brand fw-bold text-success">
        The Bread Bank
      </a>

      <div class="d-flex gap-2">
        <a href="/login" class="btn btn-outline-success">
          Login
        </a>

        <a href="/register" class="btn btn-success">
          Sign Up
        </a>
      </div>

    </div>
  </nav>

  <!-- Main homepage content -->
  <main class="container py-5">

    <div class="row justify-content-center text-center py-5">
      <div class="col-12 col-md-9 col-lg-7">

        <h1 class="display-4 fw-bold text-success mb-4">
          Good Food. Better Communities.
        </h1>

        <p class="lead text-muted mb-3">
          Connect local bakeries and businesses with people
          who can put surplus food to good use.
        </p>

        <p class="text-muted mb-4">
          Reduce food waste, support your neighbors,
          and make every donation count.
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-3">

          <!-- Registration page -->
          <a href="/register" class="btn btn-success btn-lg">
            Get Started
          </a>

          <!-- Login page -->
          <a href="/login" class="btn btn-outline-success btn-lg">
            Login
          </a>

        </div>

      </div>
    </div>

  </main>

</body>
</html>