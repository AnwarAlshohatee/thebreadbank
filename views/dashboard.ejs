<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | The Bread Bank</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

  <!-- Navigation bar -->
  <nav class="navbar bg-white border-bottom shadow-sm">
    <div class="container">

      <a href="/dashboard" class="navbar-brand fw-bold text-success">
        The Bread Bank
      </a>

      <form action="/logout" method="POST" class="m-0">
        <button type="submit" class="btn btn-outline-secondary btn-sm">
          Logout
        </button>
      </form>

    </div>
  </nav>

  <main class="container py-5">

    <!-- Welcome section -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

          <div>
            <h1 class="h3 fw-bold mb-2">
              Welcome, <%= user.name %>!
            </h1>

            <p class="text-muted mb-0">
              Account type:
              <span class="badge bg-success">
                <%= user.role %>
              </span>
            </p>
          </div>

          <!-- Only businesses can create donations -->
          <% if (user.role === "business") { %>
            <a href="/donations/new" class="btn btn-success">
              + Post Donation
            </a>
          <% } %>

        </div>
      </div>
    </div>

    <h2 class="h4 fw-bold mb-4">Food Donations</h2>

    <!-- Empty state -->
    <% if (donations.length === 0) { %>
      <div class="alert alert-info">
        No donations have been posted yet.
      </div>
    <% } %>

    <!-- Responsive donation cards -->
    <div class="row g-4">

      <% donations.forEach(donation => { %>

        <div class="col-12 col-md-6 col-lg-4">

          <div class="card h-100 shadow-sm">
            <div class="card-body p-4">

              <span class="badge <%= donation.status === 'available' ? 'bg-success' : 'bg-secondary' %> mb-3">
                <%= donation.status %>
              </span>

              <h3 class="h5 fw-bold">
                <%= donation.title %>
              </h3>

              <p class="text-muted">
                <%= donation.description %>
              </p>

              <hr>

              <p class="small mb-2">
                <strong>Quantity:</strong>
                <%= donation.quantity %>
              </p>

              <p class="small mb-2">
                <strong>Pickup:</strong>
                <%= new Date(donation.pickupTime).toLocaleString() %>
              </p>

              <p class="small mb-2">
                <strong>Location:</strong>
                <%= donation.pickupLocation %>
              </p>

              <p class="small text-muted">
                Donated by:
                <%= donation.createdBy?.name || "Unknown" %>
              </p>

              <!-- Only recipients can claim available donations. -->
                <% if (
                  user.role === "recipient" &&
                  donation.status === "available"
                ) { %>

                  <form
                    action="/donations/<%= donation._id %>/claim"
                    method="POST"
                    class="mt-3"
                  >
                    <button type="submit" class="btn btn-success w-100">
                      Claim Donation
                    </button>
                  </form>

                <% } %>

                <!-- Show confirmation to the recipient who claimed it. -->
                <% if (
                  user.role === "recipient" &&
                  donation.status === "claimed" &&
                  donation.claimedBy &&
                  donation.claimedBy.toString() === user._id.toString()
                ) { %>

                  <div class="alert alert-success mt-3 mb-0">
                    You claimed this donation! Please arrange your pickup.
                  </div>

                <% } %>

              <!-- Only the owner can edit or delete an available listing -->
              <% if (
                user.role === "business" &&
                donation.status === "available" &&
                donation.createdBy &&
                donation.createdBy._id.toString() === user._id.toString()
              ) { %>

                <div class="d-flex gap-2 flex-wrap mt-3">

                  <a
                    href="/donations/<%= donation._id %>/edit"
                    class="btn btn-outline-primary btn-sm"
                  >
                    Edit
                  </a>

                  <form
                    action="/donations/<%= donation._id %>/delete"
                    method="POST"
                    class="m-0"
                  >
                    <button
                      type="submit"
                      class="btn btn-outline-danger btn-sm"
                      onclick="return confirm('Delete this donation?')"
                    >
                      Delete
                    </button>
                  </form>

                </div>

              <% } %>

            </div>
          </div>

        </div>

      <% }) %>

    </div>

  </main>

</body>
</html>